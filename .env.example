# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Public HTTPS URL of this deployment (needed for Telegram webhooks) ---
PUBLIC_URL=https://botconnect.example.com

# --- Secrets (generate with: openssl rand -base64 32) ---
SESSION_SECRET=
ENCRYPTION_KEY=          # encrypts bot tokens at rest (AES-256-GCM)
CRON_SECRET=             # protects GET /api/cron
MAIN_BOT_WEBHOOK_SECRET= # secret_token for the main bot webhook

# --- Main Bot Connect bot (login + notifications) ---
MAIN_BOT_TOKEN=
MAIN_BOT_USERNAME=       # without @, used by the Telegram Login Widget
ADMINS=                  # comma-separated Telegram IDs with admin flag

# --- Payments via @CryptoBot (optional) ---
CRYPTO_BOT_TOKEN=
CRYPTO_BOT_TESTNET=false
PLANS_JSON=[{"months":1,"price":5},{"months":3,"price":12},{"months":12,"price":40}]

# --- Limits ---
FREE_DAILY_MAILING_LIMIT=100
PRO_DAILY_MAILING_LIMIT=50000
FREE_BOTS_LIMIT=3

# --- Local development only. NEVER enable in production ---
ALLOW_DEV_LOGIN=false
